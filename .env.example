# Configure a Chat Completions endpoint with strict JSON-schema support.
# Copy to .env (ignored by Git). Never commit an API key.
AP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AP_LLM_MODEL=gemini-3.5-flash-lite
AP_LLM_API_KEY=
AP_LLM_MIN_INTERVAL_SECONDS=60
AP_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Local event receiver only. Match the n8n HTTP Header Auth credential value.
AP_REVIEW_EVENT_TOKEN=
# To switch provider, change URL, model and key together, then recreate python-api.
# OpenAI alternative URL: https://api.openai.com/v1 ; model: gpt-4.1-mini
# No automatic provider fallback. Keep the key out of workflow JSON.
