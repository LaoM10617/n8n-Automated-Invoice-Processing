    {
      "id": "0a4d15f6-a477-443d-b9c6-7d8178937022",
      "name": "Summarize Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        240
      ],
      "parameters": {
        "jsCode": "const source=$('Attachment Input').first().json;\nlet intake={}, review={}, processing={};\ntry {intake=$('Store Original and Register Intake').first().json;} catch {}\ntry {processing=$('Extract Validate and Check Duplicates').first().json;} catch {}\ntry {review=$('Create Review Task').first().json;} catch {}\nconst saved=intake.body || {};\nconst status=!source.supported?'skipped':!saved.receipt_id?'intake_failed':review.body?.review_status==='pending'?'review_ready':processing.body?.processing_status==='processed'?'review_failed':'processing_failed';\nconst reason=!source.supported?source.skip_reason:status==='review_ready'?'PENDING_REVIEW':`HTTP_${(status==='intake_failed'?intake:status==='processing_failed'?processing:review).statusCode || 'NETWORK_ERROR'}`;\nreturn [{json:{source_namespace:source.source_namespace,source_id:source.source_id,attachment_id:source.attachment_id,batch_id:source.batch_id,case_id:source.case_id,status,reason_code:reason,receipt_id:saved.receipt_id || null,invoice_id:saved.invoice_id || null}}];"
      }
    },
