    {
      "id": "8a415f89-0fa8-46c1-8a85-0db5a614680a",
      "name": "Classify SMTP Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        -60
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst claim=$('Claim Notification').first().json.body;\nconst error=String(r.error || '');\nconst sent=Boolean(r.messageId && (r.accepted || []).includes('reviewer@example.invalid'));\nconst definite=/ECONNREFUSED|ENOTFOUND|EAI_AGAIN|Invalid login|No recipients defined/.test(error);\nreturn [{json:{notification_id:claim.notification_id,status:sent?'sent':definite?'failed':'unknown',message_id:sent?r.messageId:null,error_code:sent?null:definite?'SMTP_CONNECTION_FAILED':'SMTP_DELIVERY_UNCERTAIN'}}];"
      }
    },
