            "index": 0
          }
        ]
      ]
    },
    "Extract Validate and Check Duplicates": {
      "main": [
        [
          {
            "node": "Format Intake Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Intake Result": {
      "main": [
        [
          {
            "node": "Show Intake Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Berlin",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "pinData": {}
}
