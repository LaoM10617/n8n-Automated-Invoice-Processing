{
  "id": "APIntakeProcessV2",
  "name": "01_AP_Intake_Process_v2",
  "nodes": [
    {
      "id": "d33120fd-6a7a-48be-b42e-96dd6a3b472a",
      "name": "Upload Invoice",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [
        0,
        240
      ],
      "parameters": {
        "path": "ap-intake-process-v2",
        "formTitle": "AP Invoice Processing",
        "formDescription": "Upload one PDF, JPEG or PNG. The original is stored, then OCR/text extraction and validation are attempted. Reuse Upload ID only to retry the same file. Review tasks are not implemented.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload ID",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "e.g. ap-upload-001"
            },
            {
              "fieldLabel": "Invoice File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf,.jpg,.jpeg,.png",
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {
          "buttonLabel": "Store invoice",
          "appendAttribution": false
        }
      },
      "webhookId": "a79670e7-2507-4e21-ba45-33d236b703e4"
    },
    {
      "id": "a13e06cb-5d88-48a8-85d4-eb07baf2c669",
      "name": "Normalize Upload",
      "type": "n8n-nodes-base.code",
      "position": [
        280,
        240
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (keys.length !== 1) throw new Error('Upload exactly one file.');\nconst sourceId = String(item.json['Upload ID'] || '').trim();\nif (!sourceId || sourceId.length > 200) throw new Error('Upload ID must contain 1 to 200 characters.');\nreturn [{json: {direction: 'AP', source_type: 'upload', source_namespace: 'n8n-ap-upload-v1', source_id: sourceId, attachment_id: '0'}, binary: {data: item.binary[keys[0]]}}];"
      },
      "typeVersion": 2
    },
    {
      "id": "efa75d18-c25e-417c-8831-6f3b880ecf51",
      "name": "Store Original and Register Intake",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        560,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://python-api:8000/api/ap/intakes",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "source_type",
              "value": "={{ $json.source_type }}"
            },
            {
              "name": "source_namespace",
              "value": "={{ $json.source_namespace }}"
            },
            {
              "name": "source_id",
              "value": "={{ $json.source_id }}"
            },
            {
              "name": "attachment_id",
              "value": "={{ $json.attachment_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "1021ab90-d2c1-4900-9f09-8eadca1c0aa1",
      "name": "Format Intake Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        240
      ],
      "parameters": {
        "jsCode": "const intake = $('Store Original and Register Intake').first().json;\nconst current = $input.first().json;\nconst saved = intake.body || {};\nconst ok = [200,201].includes(intake.statusCode) && Boolean(saved.invoice_id);\nconst result = current.body || {};\nlet message;\nif (!ok) {\n message = `Upload not accepted (HTTP ${intake.statusCode}). No processing was started. Check the Upload ID and file.`;\n} else if (current.statusCode === 200 && result.processing_status === 'processed') {\n const codes = (result.validation_issues || []).map(x => x.code);\n message = `Original stored. Invoice ID: ${saved.invoice_id}. Receipt ID: ${saved.receipt_id}. Processing completed; manual review required. Business duplicate check: ${result.business_duplicate_status}. Issues: ${codes.length ? codes.join(', ') : 'none detected'}. Review task and notifications are not implemented yet.`;\n} else {\n const error = result.detail || {};\n message = `Original stored. Invoice ID: ${saved.invoice_id}. Receipt ID: ${saved.receipt_id}. Processing did not complete (HTTP ${current.statusCode}, ${error.code || 'PROCESSING_ERROR'}). No approval or review task was created. Retry with the same Upload ID after resolving the error.`;\n}\nreturn [{json:{formSubmittedText:message,intake_success:ok,processing_success:ok && result.processing_status === 'processed',intake:saved,processing:result}}];"
      }
    },
    {
      "id": "7a87a7cf-0299-466d-b250-86982bef4ba4",
      "name": "Show Intake Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1620,
        240
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { formSubmittedText: $json.formSubmittedText } }}",
        "options": {}
      }
    },
    {
      "id": "d7979075-8fc9-4751-9c8b-f04e6df535ff",
      "name": "Scope and Template Provenance",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "width": 1720,
        "height": 250,
        "content": "## Step 4: real processing\nDerived from 01_AP_intake_upload_v1.json and the preserved original Email invoice archiving & data extraction.json.\n\nAccepted intake calls /process: native text or local Tesseract OCR, configured OpenAI extraction, deterministic validation and duplicate candidates. Retries reuse completed processing. Upload ID namespace remains shared with v1 for replay safety.\n\nMissing model configuration is a technical failure, not successful extraction. OCR may already be stored. Manual review is always required. Review tasks, notifications and export are not implemented. Credentials stay in the backend environment. File export is inactive; local publication is recorded in the handoff."
      }
    },
    {
      "id": "c1380588-5eae-4a18-9645-f00781d91cf9",
      "name": "Intake Accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        800,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1f6e4792-18b4-4b04-b8a8-fcea517e4597",
              "leftValue": "={{ Boolean($json.body && $json.body.invoice_id && ($json.statusCode === 200 || $json.statusCode === 201)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4b535f55-cd1b-49e8-9146-1cb0aeb7a92b",
      "name": "Extract Validate and Check Duplicates",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1060,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://python-api:8000/api/ap/invoices/' + $json.body.invoice_id + '/process' }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "typeVersion": 4.2
    }
  ],
  "connections": {
    "Upload Invoice": {
      "main": [
        [
          {
            "node": "Normalize Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Upload": {
