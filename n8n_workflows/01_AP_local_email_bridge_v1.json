      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "content": "## Local SMTP integration test bridge\nThe Python batch tool reads actual messages received by Mailpit, parses MIME attachments and POSTs each attachment here. This is a real local mail path, not Gmail API validation. Calls the same attachment child as Gmail. Loopback demo only; no authentication or production exposure. No mail deletion.",
        "height": 240,
        "width": 780
      }
    }
