      "id": "43c623bb-c885-444d-b0fa-f7eaf784050d",
      "name": "Normalize Local Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "jsCode": "const i=$input.first();const b=i.json.body;const keys=Object.keys(i.binary || {});const data=keys.length?i.binary[keys[0]]:null;if(b.source_namespace!=='mailpit:ap-test-inbox')throw new Error('Local Mailpit sources only.');return [{json:{...b,source_type:'email',supported:b.supported==='true'},...(data?{binary:{data}}:{})}];"
      }
    },
    {
      "id": "b97b4f88-f5b7-41c1-83b7-a64747a42cce",
      "name": "Process Attachment",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        480,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "APEmailAttachmentV1",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "05021fcd-da8e-4f56-8fc3-b56fbea3d33c",
      "name": "Return Outcome",
      "type": "n8n-nodes-base.respondToWebhook",
