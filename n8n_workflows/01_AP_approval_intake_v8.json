        "formDescription": "AP intake with deterministic approval. Eligible EUR gross totals below 10,000 are approved; exceptions go to local review. Export delivery is not connected yet. Reuse Upload ID to retry.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload ID",
              "placeholder": "e.g. ap-upload-001",
              "requiredField": true
            },
            {
              "fieldLabel": "Invoice File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf,.jpg,.jpeg,.png",
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Store invoice"
        }
