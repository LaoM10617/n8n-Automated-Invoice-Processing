        },
        "options": {}
      }
    },
    {
      "id": "a83f624c-70e6-47d7-a53e-c5ca5e0269d4",
      "name": "Send Local Review Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2540,
        -60
      ],
      "parameters": {
        "fromEmail": "ap-review@example.invalid",
        "toEmail": "reviewer@example.invalid",
        "subject": "={{ $json.body.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "APLocalMailpitSMTP",
          "name": "AP Local Mailpit"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "8a415f89-0fa8-46c1-8a85-0db5a614680a",
      "name": "Classify SMTP Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        -60
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nconst claim=$('Claim Notification').first().json.body;\nconst error=String(r.error || '');\nconst sent=Boolean(r.messageId && (r.accepted || []).includes('reviewer@example.invalid'));\nconst definite=/ECONNREFUSED|ENOTFOUND|EAI_AGAIN|Invalid login|No recipients defined/.test(error);\nreturn [{json:{notification_id:claim.notification_id,status:sent?'sent':definite?'failed':'unknown',message_id:sent?r.messageId:null,error_code:sent?null:definite?'SMTP_CONNECTION_FAILED':'SMTP_DELIVERY_UNCERTAIN'}}];"
      }
    },
    {
      "id": "5985a961-2023-4fd8-b530-42105a8365eb",
      "name": "Record Notification Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3020,
        -60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://python-api:8000/api/ap/notifications/' + $json.notification_id + '/result' }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {status:$json.status,message_id:$json.message_id,error_code:$json.error_code} }}"
      }
    }
  ],
