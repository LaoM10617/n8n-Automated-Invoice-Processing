    {
      "id": "9d7dc2f4-e37f-4809-8523-28e36a5d4830",
      "name": "Send Required",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2300,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "1f6e4792-18b4-4b04-b8a8-fcea517e4597",
              "leftValue": "={{ Boolean($json.statusCode === 200 && $json.body && $json.body.send_required) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
