    {
      "id": "48293056-aba8-4dbc-a714-20cb3112d2ce",
      "name": "Decision and Export Contract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -240
      ],
      "parameters": {
        "content": "## Independent outcome workflow\nReview decisions and completed Excel batches have separate entries. Read authoritative state from Python before routing. Approved snapshots are already in the Web export register; approval does not automatically create a file. Users preview/select/download combined Excel, then receive a batch download notice.",
        "width": 1250,
        "height": 220
      }
    },
    {
      "id": "36584676-81e6-44b6-871f-2ffe8a001295",
      "name": "Recovery and Local Scope",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        750
      ],
      "parameters": {
        "content": "## Durable recovery; local demonstration only\nHeader credentials and the Compose privacy hook are required on both webhook paths. HTTP 202 is acceptance, not business completion. Python persists bounded transport/SMTP attempts; uncertain SMTP sends require Mailpit Message-ID reconciliation, never blind resend. Only confirmed notification delivery completes the review event. Notification failure never reapproves or regenerates Excel. No external mail, accounting submission or payment.",
        "width": 1250,
        "height": 220
      }
    }
  ],
