{
  "id": "APGmailIntakeV1",
  "name": "01_AP_Gmail_Intake_v1",
  "nodes": [
    {
      "id": "e44ce226-7e53-44f6-80a8-5912090fee96",
      "name": "Get many messages",
      "type": "n8n-nodes-base.gmail",
      "position": [
        250,
        200
      ],
      "webhookId": "af615cf7-1086-4de1-b3a6-020e6f96bcf1",
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "simple": false,
        "filters": {
          "q": "subject:AP-DEMO subject:phase01-connect-001"
        },
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        }
      },
      "typeVersion": 2.1,
      "credentials": {
        "gmailOAuth2": {
          "id": "SGOORT8HCIJeyC72",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "8f272faa-194c-4765-a726-849ce30ea400",
      "name": "Run Controlled Batch",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "4de701d2-4ab2-4f8c-9acb-4ead98cbcaff",
      "name": "Split Email Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        200
      ],
      "parameters": {
        "jsCode": "const results=[];\nfor (const [i,item] of $input.all().entries()) {\n const j=item.json;\n const match=String(j.subject || '').match(/^\\[AP-DEMO\\]\\[([A-Za-z0-9_-]{1,80})\\]\\[([A-Za-z0-9_-]{1,80})\\]/);\n if (!match || !j.id) throw new Error('Expected a batch-tagged email with a provider message ID.');\n const keys=Object.keys(item.binary || {});\n for (const key of keys.length?keys:['none']) {\n  const b=item.binary?.[key];\n  const supported=Boolean(b && ['application/pdf','image/png','image/jpeg'].includes(b.mimeType));\n  results.push({json:{source_type:'email',source_namespace:'gmail:ap-test-inbox',source_id:String(j.id),attachment_id:key,batch_id:match[1],case_id:match[2],supported,skip_reason:b?'UNSUPPORTED_ATTACHMENT':'NO_ATTACHMENTS'},...(b?{binary:{data:b}}:{}),pairedItem:{item:i}});\n }\n}\nreturn results;"
      }
    },
    {
      "id": "75a4f8df-0efc-4e15-b2b6-7a9dd1bde056",
      "name": "One Attachment at a Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        750,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "325baa1c-a055-4a8e-a456-fa3f6ed1cb11",
      "name": "Process Attachment",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "APEmailAttachmentV1",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "ce2db231-a56a-4f6b-80b9-d0114e761a11",
      "name": "Batch Finished",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1250,
        200
      ],
      "parameters": {}
    },
    {
      "id": "b9bc060b-283e-41ca-9e59-7bf6b19ed026",
      "name": "Scope and Provenance",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "content": "## Gmail intake - manual batch only\nDerived from original Get many messages template. Bind the dedicated Gmail credential, grant read-only scope, and confirm the batch query before execution. No scheduling or mailbox deletion. Each MIME attachment ordinal retains its provider message ID. Child handles invalid items independently. Account mapping stays in private runtime configuration, not this export. Gmail binding and live execution must be verified separately.",
        "height": 250,
        "width": 850
      }
    }
  ],
  "connections": {
