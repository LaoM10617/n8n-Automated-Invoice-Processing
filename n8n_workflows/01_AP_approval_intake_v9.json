        "formTitle": "AP Invoice Intake and Review",
        "formDescription": "Upload an AP invoice. Eligible low-value EUR invoices enter the export register automatically; other invoices need review. Results go to local Mailpit. Reuse Upload ID for safe retries.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload ID",
              "placeholder": "e.g. ap-upload-001",
              "requiredField": true
            },
            {
              "fieldLabel": "Invoice File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf,.jpg,.jpeg,.png",
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Store invoice"
